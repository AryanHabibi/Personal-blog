DATABASE_URL=sqlite:///./weblog.db
# generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-generated-random-value
ALGORITHM=HS256

# from a Mailtrap sandbox inbox (or any SMTP provider): Email Testing -> Inbox -> SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=replace-with-your-mailtrap-username
SMTP_PASSWORD=replace-with-your-mailtrap-password
SMTP_FROM_EMAIL=no-reply@weblog.local
APP_BASE_URL=http://127.0.0.1:8000
