# Copy to api/app/.env and fill in real values. .env is gitignored.

# Postgres (default). For a quick SQLite fallback: sqlite:///./app.db
DATABASE_URL=postgresql+psycopg://weblog:weblog@localhost:5432/weblog

# The one and only admin (no DB row)
ADMIN_USERNAME=aryan
ADMIN_PASSWORD=set-a-strong-password

# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email verification
APP_BASE_URL=http://localhost:8000
EMAIL_BACKEND=console          # "console" logs the link to the server; "smtp" sends it
EMAIL_FROM=no-reply@weblog.local
VERIFICATION_TOKEN_TTL_HOURS=24
# only needed when EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
